{
  "name": "pandora-online-bookstore",
  "version": "1.0.0",
  "description": "Pandora Online Book Store - Academic Mini Project",
  "private": true,
  "scripts": {
    "build": "npm --prefix client install && npm --prefix client run build && npm --prefix server install",
    "start": "node server/src/server.js",
    "client:dev": "npm run dev --prefix client",
    "client:build": "npm run build --prefix client",
    "server:dev": "npm run dev --prefix server",
    "server:start": "npm run start --prefix server",
    "seed": "npm run seed --prefix server",
    "test:acceptance": "node server/src/scripts/runAcceptanceTests.js"
  },
  "keywords": [
    "bookstore",
    "react",
    "express",
    "mongodb",
    "fullstack"
  ],
  "author": "",
  "license": "ISC"
}
